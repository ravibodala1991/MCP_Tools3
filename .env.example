# ── AWS (uses inbuilt credentials / IAM role – no keys needed if on EC2/Cloud9) ──
AWS_REGION=us-east-1
# AWS_PROFILE=default   # uncomment to use a named profile locally

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_BUCKET=mcp-raw-docs
S3_DOCS_PREFIX=documents/          # prefix where documents are stored in S3

# ── FAISS (local disk) ────────────────────────────────────────────────────────
FAISS_INDEX_DIR=./faiss_index      # directory to store index.faiss + metadata.pkl

# ── Bedrock Models ────────────────────────────────────────────────────────────
LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
EMBED_DIM=1024
RAG_TOP_K=5
