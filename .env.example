# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default                    # or use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# ── Populated automatically after `cdk deploy` ────────────────────────────────
# Copy values from CDK outputs or SSM Parameter Store

S3_RAW_BUCKET=mcp-raw-docs-<ACCOUNT_ID>-us-east-1
OPENSEARCH_ENDPOINT=<collection-id>.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX=mcp-documents
KNOWLEDGE_BASE_ID=<bedrock-kb-id>

# ── Model IDs (defaults shown) ────────────────────────────────────────────────
LLM_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5
SEARCH_TOP_K=5
